# ── BoxerOS — production .env template ──
# Copy to .env on the server, fill in the real values, then run:
#   php artisan key:generate
#   php artisan migrate --force
#   php artisan config:cache && php artisan route:cache && php artisan view:cache

APP_NAME=BoxerOS
APP_ENV=production
APP_KEY=                      # run `php artisan key:generate`
APP_DEBUG=false              # MUST be false in production
APP_URL=https://your-domain.com

# ── Database (use your host's managed MySQL) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=boxeros
DB_USERNAME=boxeros
DB_PASSWORD=change-me

# ── CORNER AI (Anthropic) ──
ANTHROPIC_API_KEY=           # your sk-ant-... key (kept secret, never commit)

# ── Mail (verification + password resets) — e.g. Brevo / Resend ──
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.com
MAIL_FROM_NAME=BoxerOS

# ── Sessions / cache / queue (database is fine to start) ──
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true    # requires HTTPS
CACHE_STORE=database
QUEUE_CONNECTION=database

LOG_CHANNEL=daily
LOG_LEVEL=error

# ── Optional: error monitoring (add after you create a Sentry project) ──
# SENTRY_LARAVEL_DSN=
